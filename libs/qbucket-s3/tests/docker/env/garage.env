# Test-only credentials (public, local container). Garage key IDs are
# "GK" + 24 hex digits, secrets 64 hex digits.
GARAGE_KEY_ID=GK0123456789abcdef01234567
GARAGE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# For tests/it_s3_backend (QBUCKET_IT_*).
QBUCKET_IT_ENDPOINT=http://127.0.0.1:3900
QBUCKET_IT_REGION=garage
QBUCKET_IT_ACCESS_KEY=GK0123456789abcdef01234567
QBUCKET_IT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
QBUCKET_IT_ADDRESSING=path
QBUCKET_IT_PROVIDER=generic
QBUCKET_IT_BACKEND=garage
QBUCKET_IT_BUCKET=qbucket-it-garage
QBUCKET_IT_CREATE_BUCKET=1
